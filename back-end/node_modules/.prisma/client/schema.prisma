generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                   @id @default(uuid())
  name                   String
  email                  String                   @unique
  cpf                    String                   @unique
  password               String
  user_type              Role                     @default(ALUNO)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @default(now()) @updatedAt
  Certificate            Certificate[]
  atividade_complementar atividade_complementar[]
  eventos                event[]                  @relation("ProfessorEventos")
  event_aluno            event_aluno[]
}

model Certificate {
  id          String   @id @default(uuid())
  titulo      String
  descricao   String
  horas       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  urlArquivo  String
  userId      String?
  isValid     Boolean  @default(false)
  datafim     DateTime
  datainicio  DateTime
  instituicao String
  isReviewed  Boolean  @default(false)
  User        User?    @relation(fields: [userId], references: [id])
}

model event {
  id                     String                   @id @default(uuid())
  titulo                 String
  descricao              String
  datainicio             DateTime
  datafim                DateTime
  instituicao            String
  carga_horaria          Int
  limite_vagas           Int                      @default(0)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @default(now()) @updatedAt
  professorId            String?
  isValid                Boolean                  @default(true)
  status                 String                   @default("EM ANDAMENTO")
  atividade_complementar atividade_complementar[]
  professor              User?                    @relation("ProfessorEventos", fields: [professorId], references: [id])
  event_aluno            event_aluno[]
}

model event_aluno {
  id                  String                    @id @default(uuid())
  subscription_status event_subscription_status @default(SUBSCRIBED)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @default(now()) @updatedAt
  userId              String
  eventId             String
  event               event                     @relation(fields: [eventId], references: [id])
  User                User                      @relation(fields: [userId], references: [id])
}

model atividade_complementar {
  id                 String             @id @default(uuid())
  participation_type Participation_type @default(PARTICIPANTE)
  horas_aprovadas    Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @default(now()) @updatedAt
  eventId            String?
  userId             String?
  event              event?             @relation(fields: [eventId], references: [id])
  User               User?              @relation(fields: [userId], references: [id])
}

enum event_subscription_status {
  SUBSCRIBED
  PRESENT
  NOT_PRESENT
  FINISHED
}

enum Activity_Nature {
  ENSINO
  PESQUISA
  GERAL
  EXTENSAO
  ESPORTIVA
  CULTURAL
}

enum Participation_type {
  ALUNO
  AUTOR
  BOLSISTA
  COLABORADOR
  ESTAGIARIO
  MEMBRO
  MONITOR
  ORGANIZADOR
  OUVINTE
  PARTICIPANTE
  OUTRO
}

enum Role {
  ALUNO
  PROFESSOR
  COORDENADOR
}
